{
  "name": "@inconnus/pai-sho",
  "productName": "Pai Sho",
  "private": true,
  "version": "0.1.0",
  "description": "Pai Sho, jeu de table en bois dans une taverne : contre la maison, à deux sur le même Mac, ou à distance par identifiant de joueur.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5178",
    "build": "tsc && vite build",
    "preview": "vite preview --port 5178",
    "test": "node scripts/test.mjs",
    "app": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac --config electron/builder.cjs"
  },
  "dependencies": {
    "@inconnus/ui": "*",
    "gsap": "^3.15.0",
    "peerjs": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
